# Copy this file to .env and fill in your own settings.
# For MongoDB Atlas, paste the connection string from your Atlas cluster.
# For local development, use: mongodb://127.0.0.1:27017/
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=astropulse
BATCH_NAME=AstroPulse Cohort
BATCH_INVITE_CODE=replace-with-a-private-batch-code
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
PORT=5001
